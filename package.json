{
  "name": "hit-tv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --watch-path=server server/index.mjs",
    "build": "vite build",
    "start": "vite build && node server/index.mjs",
    "preview": "vite preview",
    "catalog": "node scripts/build-catalog.mjs",
    "scan": "node scripts/scan-drive.mjs",
    "sync": "node scripts/scan-drive.mjs && node scripts/build-catalog.mjs",
    "bundle": "vite build && node scripts/bundle-discloud.mjs",
    "deploy": "npm run bundle && node scripts/deploy-discloud.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "5.9",
    "vite": "^8.3.5"
  }
}
